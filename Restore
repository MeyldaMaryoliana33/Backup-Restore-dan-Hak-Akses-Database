# codingan
-- Membuat database pengujian (nama harus berbeda dari database utama)
CREATE DATABASE db_meyldamaryoliana_uji;

-- Setelah file backup di-import ke database uji:

-- Daftar tabel
SHOW TABLES FROM db_meyldamaryoliana;
SHOW TABLES FROM db_meyldamaryoliana_uji;

-- Perbandingan jumlah data (diulang untuk setiap tabel)
SELECT (SELECT COUNT(*) FROM db_meyldamaryoliana.mahasiswa)     AS jumlah_utama_mahasiswa,
       (SELECT COUNT(*) FROM db_meyldamaryoliana_uji.mahasiswa) AS jumlah_uji_mahasiswa;

-- Perbandingan seluruh tabel sekaligus
SELECT 'mahasiswa' AS tabel,
       (SELECT COUNT(*) FROM db_meyldamaryoliana.mahasiswa)     AS utama,
       (SELECT COUNT(*) FROM db_meyldamaryoliana_uji.mahasiswa) AS uji
UNION ALL
SELECT 'dosen',
       (SELECT COUNT(*) FROM db_meyldamaryoliana.dosen),
       (SELECT COUNT(*) FROM db_meyldamaryoliana_uji.dosen)
UNION ALL
SELECT 'mata_kuliah',
       (SELECT COUNT(*) FROM db_meyldamaryoliana.mata_kuliah),
       (SELECT COUNT(*) FROM db_meyldamaryoliana_uji.mata_kuliah)
UNION ALL
SELECT 'kelas_kuliah',
       (SELECT COUNT(*) FROM db_meyldamaryoliana.kelas_kuliah),
       (SELECT COUNT(*) FROM db_meyldamaryoliana_uji.kelas_kuliah)
UNION ALL
SELECT 'krs',
       (SELECT COUNT(*) FROM db_meyldamaryoliana.krs),
       (SELECT COUNT(*) FROM db_meyldamaryoliana_uji.krs)
UNION ALL
SELECT 'nilai',
       (SELECT COUNT(*) FROM db_meyldamaryoliana.nilai),
       (SELECT COUNT(*) FROM db_meyldamaryoliana_uji.nilai)
UNION ALL
SELECT 'program_studi',
       (SELECT COUNT(*) FROM db_meyldamaryoliana.program_studi),
       (SELECT COUNT(*) FROM db_meyldamaryoliana_uji.program_studi);
